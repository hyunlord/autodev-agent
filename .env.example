# AutoDev Agent — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── VLM (Visual Language Model) — 디자인 품질 시각 분석 ───
# OpenRouter (1순위 — 다양한 모델 지원)
# OPENROUTER_API_KEY=sk-or-v1-xxx

# VLM 모델 (OpenRouter 사용 시)
# AUTODEV_VLM_MODEL=google/gemini-3.1-flash-lite-preview

# VLM 다중 실행 (majority voting, 비용 N배)
# AUTODEV_VLM_RUNS=3

# ─── Worker Pool (J2) ───
# 동시 실행 파이프라인 수 (기본 3)
# AUTODEV_MAX_WORKERS=3

# ─── SAST (보안 스캔) ───
# Semgrep 자동 실행 (기본 비활성)
# AUTODEV_SAST_ENABLED=1

# ─── pre-commit hook ───
# Verify Agent 실행 (기본 비활성)
# AUTODEV_PRECOMMIT_VERIFY=1
# Verify Agent 실패 시 커밋 차단
# AUTODEV_PRECOMMIT_VERIFY_STRICT=1

# ─── I7: Property-Based Testing (deep 모드에서만, LLM 호출 추가) ───
# AUTODEV_PBT_ENABLED=1

# ─── I8: Debate Verification (deep 모드에서만, LLM 2회 호출) ───
# AUTODEV_DEBATE_VERIFY=1

# ─── Layer 1 (AutoDev self-development) ───
# Verify Agent를 위한 Gemini CLI가 설치되어 있어야 합니다
# brew install gemini-cli  (Google Gemini CLI — Homebrew 권장)
#
# pre-commit hook 설치
# pnpm hook:install
#
# 커밋 전 검증 (필수)
# pnpm verify:cross
