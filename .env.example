# AutoDev Agent — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── VLM (Visual Language Model) — 디자인 품질 시각 분석 ───
# OpenRouter (1순위 — 다양한 모델 지원)
# OPENROUTER_API_KEY=sk-or-v1-xxx

# Anthropic 직접 (2순위)
# ANTHROPIC_API_KEY=sk-ant-xxx

# VLM 모델 (OpenRouter 사용 시)
# AUTODEV_VLM_MODEL=google/gemini-3.1-flash-lite-preview

# VLM 다중 실행 (majority voting, 비용 N배)
# AUTODEV_VLM_RUNS=3

# ─── SAST (보안 스캔) ───
# Semgrep 자동 실행 (기본 비활성)
# AUTODEV_SAST_ENABLED=1

# ─── pre-commit hook ───
# Verify Agent 실행 (기본 비활성)
# AUTODEV_PRECOMMIT_VERIFY=1
# Verify Agent 실패 시 커밋 차단
# AUTODEV_PRECOMMIT_VERIFY_STRICT=1
