{
  "servers": {
    "playwright": {
      "type": "local",
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "enabled": true,
      "timeout": 120000
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false
    }
  },
  "pipeline_mapping": {
    "planning": ["context7"],
    "coding": ["playwright", "context7"],
    "verification": ["playwright"]
  }
}
