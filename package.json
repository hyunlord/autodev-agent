{
  "name": "autodev-agent",
  "version": "0.1.0",
  "description": "Universal AI development orchestrator — Plan, Code, Verify with multiple LLM agents",
  "keywords": [
    "ai",
    "coding",
    "agent",
    "orchestrator",
    "llm",
    "development",
    "automation"
  ],
  "author": "Kwan Hyeon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyunlord/autodev-agent.git"
  },
  "homepage": "https://github.com/hyunlord/autodev-agent#readme",
  "bugs": {
    "url": "https://github.com/hyunlord/autodev-agent/issues"
  },
  "bin": {
    "autodev-agent": "./bin/cli.ts"
  },
  "files": [
    "bin/",
    "src/",
    "public/",
    "scripts/",
    ".autodev/agents/",
    ".autodev/hooks.json",
    ".autodev/mcp/",
    ".autodev/prompts/",
    ".autodev/skills/",
    "drizzle/",
    "next.config.ts",
    "tsconfig.json",
    "tailwind.config.ts",
    "postcss.config.mjs",
    "package.json",
    "README.md",
    "LICENSE",
    "docs/"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify": "bash scripts/verify.sh quick",
    "verify:full": "bash scripts/verify.sh full",
    "verify:cross": "bash scripts/verify.sh cross",
    "verify:e2e": "bash scripts/e2e-test.sh",
    "verify:agent": "npx tsx scripts/verify-agent.ts",
    "ship": "bash scripts/ship.sh",
    "hook:install": "bash scripts/install-hooks.sh install",
    "hook:uninstall": "bash scripts/install-hooks.sh uninstall",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "publish:npm": "bash scripts/publish.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.86",
    "@anthropic-ai/sdk": "^0.80.0",
    "@clack/prompts": "^0.10.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@xyflow/react": "^12.10.2",
    "better-sqlite3": "^11.10.0",
    "cmdk": "^1.1.1",
    "commander": "^13.1.0",
    "cosmiconfig": "^9.0.1",
    "dagre": "^0.8.5",
    "driver.js": "^1.4.0",
    "drizzle-orm": "^0.39.3",
    "execa": "^9.6.1",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.1",
    "mermaid": "^11.14.0",
    "nanoid": "^5.1.7",
    "next": "^15.5.14",
    "p-queue": "^8.1.1",
    "pino": "^9.14.0",
    "playwright": "^1.58.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "screenshot-desktop": "^1.15.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^4.2.2",
    "tree-kill": "^1.2.2",
    "wait-on": "^9.0.4",
    "zod": "^3.25.76"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "sharp"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/dagre": "^0.7.54",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.5.0",
    "@types/react": "19.2.14",
    "@types/screenshot-desktop": "^1.15.0",
    "@types/wait-on": "^5.3.4",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
